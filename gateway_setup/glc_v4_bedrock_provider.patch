+# ────────────────────────────────────────────────────────────────────────────
+# AWS Bedrock (Converse API, local-dev provider)
+# ────────────────────────────────────────────────────────────────────────────
+# This adapter uses the unified Bedrock Converse API, so a single class serves
+# Anthropic Claude, Amazon Nova, Meta Llama-on-Bedrock and any other Converse-
+# compatible model — the caller picks the family via BEDROCK_MODEL. Auth uses
+# the standard AWS credential chain (env vars, profiles, IMDS), so no keys
+# live in the provider itself.
+
+class BedrockProvider(BaseProvider):
+    name = "bedrock"
+    capabilities = {
+        "tools": False,     # tool-use path not wired in this minimal adapter
+        "caching": False,
+        "reasoning": False,
+        # Converse has no OpenAI-style response_format field, but these models
+        # emit valid JSON reliably when asked, and the gateway validates the
+        # JSON itself (with a fix-retry loop). So the adapter advertises
+        # structured output — it satisfies a response_format request by
+        # appending a JSON instruction to the system prompt and stripping any
+        # markdown fence the model wraps around the object. Without this, a
+        # judge or any structured caller skips Bedrock with "no_structured".
+        "structured": True,
+        "parallel_tools": False,
+        "vision": False,
+    }
+
+    def __init__(self, model: str, region: str = "us-east-1"):
+        super().__init__(api_key="", model=model, base_url=f"bedrock://{region}")
+        self.region = region
+        # Client is created lazily so import-time cost stays zero for setups
+        # that never opt into Bedrock.
+        self._client = None
+
+    def _get_client(self):
+        if self._client is None:
+            import boto3
+            self._client = boto3.client("bedrock-runtime", region_name=self.region)
+        return self._client
+
+    @staticmethod
+    def _flatten_content(content: Any) -> str:
+        """Bedrock Converse takes a list of content blocks per message. This
+        adapter only produces plain-text blocks — image/tool blocks are the
+        job of a later revision. Callers passing OpenAI-style multi-part
+        content are flattened to text so the S13 use-cases keep working."""
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get("type") == "text" and isinstance(block.get("text"), str):
+                        parts.append(block["text"])
+                    elif isinstance(block.get("text"), str):
+                        parts.append(block["text"])
+                elif isinstance(block, str):
+                    parts.append(block)
+            return "\n".join(parts)
+        return str(content)
+
+    async def chat(
+        self,
+        messages,
+        *,
+        max_tokens=2048,
+        temperature=0.7,
+        model=None,
+        tools=None,
+        tool_choice=None,
+        reasoning=None,
+        response_format=None,
+        system_blocks=None,
+        cache_system=False,
+    ) -> dict:
+        m = model or self.model
+        system_text, _, _ = _flatten_system(system_blocks)
+
+        # Converse has no response_format field. When one is requested, ask for
+        # raw JSON in the system prompt; the fence stripping below and the
+        # gateway's own JSON validator do the rest.
+        if response_format:
+            json_hint = (
+                "Respond with a single valid JSON object only. "
+                "Do not wrap it in markdown code fences and do not add any prose."
+            )
+            system_text = f"{system_text}\n\n{json_hint}" if system_text else json_hint
+
+        # Fold any role="system" messages into system_text and drop them from
+        # the Bedrock messages list — Converse requires the first message to
+        # be role="user" and takes system prompts as a separate top-level
+        # `system` parameter.
+        bedrock_messages: list[dict[str, Any]] = []
+        for msg in messages:
+            role = msg.get("role")
+            if role == "system":
+                extra = self._flatten_content(msg.get("content", ""))
+                if extra:
+                    system_text = f"{system_text}\n\n{extra}" if system_text else extra
+                continue
+            if role not in ("user", "assistant"):
+                # tool messages, unknown roles: fold into a user turn so we
+                # don't drop context silently.
+                text = self._flatten_content(msg.get("content", ""))
+                if text:
+                    bedrock_messages.append({"role": "user", "content": [{"text": text}]})
+                continue
+            text = self._flatten_content(msg.get("content", ""))
+            if not text:
+                continue
+            bedrock_messages.append({"role": role, "content": [{"text": text}]})
+
+        # Converse rejects empty message lists.
+        if not bedrock_messages:
+            bedrock_messages = [{"role": "user", "content": [{"text": " "}]}]
+
+        kwargs: dict[str, Any] = {
+            "modelId": m,
+            "messages": bedrock_messages,
+            "inferenceConfig": {
+                "maxTokens": int(max_tokens),
+                "temperature": float(temperature),
+            },
+        }
+        if system_text:
+            kwargs["system"] = [{"text": system_text}]
+
+        client = self._get_client()
+
+        # boto3 is sync; run it in the default executor so we don't block the
+        # gateway's asyncio loop under load.
+        import asyncio
+        loop = asyncio.get_running_loop()
+        try:
+            response = await loop.run_in_executor(None, lambda: client.converse(**kwargs))
+        except Exception as exc:
+            # Heal the request (S15 §2): newer Anthropic models on Bedrock
+            # (opus-4.8+, opus-5, sonnet-4.6+) reject `temperature` as
+            # deprecated. The provider reveals one incompatibility at a time,
+            # so drop the rejected field and retry once rather than failing a
+            # call the model could serve.
+            message = str(exc)
+            if "temperature" in message and "inferenceConfig" in kwargs \
+                    and "temperature" in kwargs["inferenceConfig"]:
+                kwargs["inferenceConfig"].pop("temperature")
+                try:
+                    response = await loop.run_in_executor(None, lambda: client.converse(**kwargs))
+                except Exception as exc2:
+                    raise ProviderError(
+                        f"bedrock converse failed: {type(exc2).__name__}: {exc2}"
+                    ) from exc2
+            else:
+                raise ProviderError(f"bedrock converse failed: {type(exc).__name__}: {exc}") from exc
+
+        output_msg = (response.get("output") or {}).get("message") or {}
+        blocks = output_msg.get("content") or []
+        text = "".join(
+            block.get("text", "")
+            for block in blocks
+            if isinstance(block, dict) and "text" in block
+        )
+        # A structured caller wants raw JSON. These models sometimes still wrap
+        # the object in a ```json fence despite the instruction; strip it so the
+        # gateway's json.loads validator sees a bare object.
+        if response_format:
+            stripped = text.strip()
+            if stripped.startswith("```"):
+                stripped = re.sub(r"^```[a-zA-Z]*\n?", "", stripped)
+                stripped = re.sub(r"\n?```\s*$", "", stripped)
+                text = stripped.strip()
+        usage = response.get("usage") or {}
+        stop_reason_map = {
+            "end_turn": "end_turn",
+            "max_tokens": "max_tokens",
+            "stop_sequence": "end_turn",
+            "tool_use": "tool_use",
+            "guardrail_intervened": "end_turn",
+            "content_filtered": "end_turn",
+        }
+        return {
+            "text": text,
+            "tool_calls": [],
+            "input_tokens": int(usage.get("inputTokens", 0)),
+            "output_tokens": int(usage.get("outputTokens", 0)),
+            "cache_creation_input_tokens": int(usage.get("cacheWriteInputTokens", 0)),
+            "cache_read_input_tokens": int(usage.get("cacheReadInputTokens", 0)),
+            "stop_reason": stop_reason_map.get(response.get("stopReason", ""), "end_turn"),
+            "model": m,
+            "tool_call_dialect": "none",
+            "reasoning_applied": False,
+        }
+
+
